v class=\"footer\">\n    <p>&copy; {{ $now.year }} InsiderAlerts. All rights reserved.</p>\n    <p><a href=\"{{ $env.NEXT_PUBLIC_APP_URL || 'https://yourdomain.com' }}/settings\">Manage preferences</a> | <a href=\"{{ $env.NEXT_PUBLIC_APP_URL || 'https://yourdomain.com' }}/unsubscribe\">Unsubscribe</a></p>\n  </div>\n</body>\n</html>",
