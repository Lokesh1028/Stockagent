    {
      "parameters": {
        "jsCode": "// Parse and validate webhook data\nconst body = $input.all()[0].json.body;\n\nconsole.log('Received user event:', JSON.stringify(body));\n\nif (!body || !body.event) {\n  throw new Error('Invalid webhook payload: missing event type');\n}\n\nif (!body.user) {\n  throw new Error('Invalid webhook payload: missing user data');\n}\n\nreturn [{\n  json: {\n    event: body.event,\n    user: body.user,\n    metadata: body.metadata || {},\n    timestamp: body.timestamp || new Date().toISOString()\n  }\n}];"
      },
