# n8n Environment Variables Configuration
# Copy this file to .env and fill in your actual values

# ============================================
# REQUIRED - API Keys
# ============================================

# Finnhub API Key
# Get your free key at: https://finnhub.io/register
# Free tier: 60 API calls per minute
FINNHUB_API_KEY=your_finnhub_api_key_here

# Telegram Bot Configuration
# Create a bot: https://t.me/botfather
# Get your chat ID: https://t.me/userinfobot
TELEGRAM_CHAT_ID=your_telegram_chat_id_here

# Email Configuration
USER_EMAIL=your_email@example.com

# ============================================
# OPTIONAL - Workflow Configuration
# ============================================

# Number of days to look back for insider trades (default: 7)
LOOKBACK_DAYS=7

# Minimum transaction value to consider significant (default: 50000)
THRESHOLD_AMOUNT=50000

# Maximum number of stocks to include in alerts (default: 5)
MAX_STOCKS=5

# ============================================
# OPTIONAL - Database Configuration
# ============================================

# PostgreSQL / Supabase connection
DATABASE_URL=postgresql://user:password@host:5432/database

# Or individual components
DB_HOST=localhost
DB_PORT=5432
DB_NAME=insider_trading_db
DB_USER=your_db_user
DB_PASSWORD=your_db_password

# ============================================
# OPTIONAL - Service Configuration
# ============================================

# Stripe API keys (for payment processing)
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret

# JWT Secret (for API authentication)
JWT_SECRET=your_random_jwt_secret_here_min_32_chars

# Application URL
APP_URL=http://localhost:3000

# API URL
API_URL=http://localhost:8080

# ============================================
# OPTIONAL - Redis (for caching)
# ============================================

REDIS_URL=redis://localhost:6379
REDIS_PASSWORD=your_redis_password

# ============================================
# OPTIONAL - Email Service (SendGrid/Mailgun)
# ============================================

SENDGRID_API_KEY=your_sendgrid_api_key
SENDGRID_FROM_EMAIL=noreply@yourdomain.com

# Or Mailgun
MAILGUN_API_KEY=your_mailgun_api_key
MAILGUN_DOMAIN=yourdomain.com

# ============================================
# OPTIONAL - SMS Service (Twilio)
# ============================================

TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=+1234567890

# ============================================
# OPTIONAL - Monitoring & Logging
# ============================================

# Sentry (error tracking)
SENTRY_DSN=your_sentry_dsn

# Log level (debug, info, warn, error)
LOG_LEVEL=info

# ============================================
# OPTIONAL - Feature Flags
# ============================================

ENABLE_TELEGRAM_ALERTS=true
ENABLE_EMAIL_ALERTS=true
ENABLE_SMS_ALERTS=false
ENABLE_WEBHOOK_ALERTS=false

# ============================================
# INSTRUCTIONS
# ============================================

# 1. Copy this file:
#    cp .env.example .env

# 2. Fill in your actual values

# 3. In n8n Cloud:
#    - Go to Settings → Environment Variables
#    - Add each variable manually

# 4. In n8n Self-hosted:
#    - Add variables to docker-compose.yml under 'environment'
#    - Or use .env file (if supported by your setup)

# 5. In workflow nodes:
#    - Access variables with {{ $env.VARIABLE_NAME }}
#    - Example: {{ $env.FINNHUB_API_KEY }}

# ============================================
# SECURITY NOTES
# ============================================

# - NEVER commit .env file to git
# - Add .env to .gitignore
# - Rotate API keys regularly
# - Use different keys for dev/staging/production
# - Enable 2FA on all accounts
# - Use strong, unique passwords
# - Limit API key permissions to minimum required

# ============================================
# SUPPORT
# ============================================

# For questions about:
# - Finnhub API: https://finnhub.io/docs/api
# - n8n: https://docs.n8n.io/
# - Telegram Bots: https://core.telegram.org/bots/api
# - Stripe: https://stripe.com/docs
# - Supabase: https://supabase.com/docs
