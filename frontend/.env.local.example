# ==============================================
# APP CONFIGURATION
# ==============================================

# App branding and URLs
NEXT_PUBLIC_APP_NAME=InsiderAlerts
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_DESCRIPTION=Real-time insider trading alerts with AI-powered analysis
NEXT_PUBLIC_SUPPORT_EMAIL=support@insideralerts.com
NEXT_PUBLIC_TWITTER_HANDLE=@insideralerts

# ==============================================
# SUPABASE CONFIGURATION
# ==============================================

# Get these from: https://app.supabase.com/project/_/settings/api
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ==============================================
# STRIPE CONFIGURATION
# ==============================================

# Get these from: https://dashboard.stripe.com/apikeys
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_xxx
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx

# Stripe Price IDs (create products in Stripe dashboard)
NEXT_PUBLIC_STRIPE_PRO_MONTHLY_PRICE_ID=price_xxx
NEXT_PUBLIC_STRIPE_PRO_YEARLY_PRICE_ID=price_xxx
NEXT_PUBLIC_STRIPE_ENTERPRISE_PRICE_ID=price_xxx

# ==============================================
# PRICING CONFIGURATION (in cents)
# ==============================================

# Pro Monthly: $19/month
NEXT_PUBLIC_PRO_MONTHLY_PRICE=1900

# Pro Yearly: $182.40/year (20% discount)
NEXT_PUBLIC_PRO_YEARLY_PRICE=18240

# Enterprise: $99/month
NEXT_PUBLIC_ENTERPRISE_PRICE=9900

# ==============================================
# FEATURE LIMITS - FREE TIER
# ==============================================

NEXT_PUBLIC_FREE_MAX_ALERTS=1
NEXT_PUBLIC_FREE_MAX_STOCKS=5
NEXT_PUBLIC_FREE_CHANNELS=email
NEXT_PUBLIC_FREE_HISTORY_DAYS=7

# ==============================================
# FEATURE LIMITS - PRO TIER
# ==============================================

# -1 = unlimited
NEXT_PUBLIC_PRO_MAX_ALERTS=-1
NEXT_PUBLIC_PRO_MAX_STOCKS=20
NEXT_PUBLIC_PRO_CHANNELS=email,telegram,sms
NEXT_PUBLIC_PRO_HISTORY_DAYS=30

# ==============================================
# FEATURE LIMITS - ENTERPRISE TIER
# ==============================================

NEXT_PUBLIC_ENTERPRISE_MAX_ALERTS=-1
NEXT_PUBLIC_ENTERPRISE_MAX_STOCKS=50
NEXT_PUBLIC_ENTERPRISE_CHANNELS=email,telegram,sms,webhook
NEXT_PUBLIC_ENTERPRISE_HISTORY_DAYS=365

# ==============================================
# DEFAULT USER PREFERENCES
# ==============================================

# Default threshold for significant trades
NEXT_PUBLIC_DEFAULT_THRESHOLD=50000

# Default lookback period in days
NEXT_PUBLIC_DEFAULT_LOOKBACK_DAYS=7

# Default alert frequency (realtime, hourly, daily, weekly)
NEXT_PUBLIC_DEFAULT_ALERT_FREQUENCY=daily

# Default maximum stocks to show
NEXT_PUBLIC_DEFAULT_MAX_STOCKS=5

# Default notification channels (JSON array as string)
NEXT_PUBLIC_DEFAULT_CHANNELS=["email"]

# Default timezone
NEXT_PUBLIC_DEFAULT_TIMEZONE=America/New_York

# ==============================================
# N8N WEBHOOK INTEGRATION
# ==============================================

# n8n webhook URL for user events (signup, subscription changes, etc.)
# Get this from your n8n Workflow 3 webhook node
NEXT_PUBLIC_N8N_USER_EVENTS_WEBHOOK=https://your-n8n-instance.com/webhook/user-events

# n8n webhook base URL
N8N_WEBHOOK_URL=https://your-n8n-instance.com/webhook

# ==============================================
# FINNHUB API (Optional - for direct calls)
# ==============================================

FINNHUB_API_KEY=your-finnhub-key

# ==============================================
# OPTIONAL - ANALYTICS & MONITORING
# ==============================================

# Google Analytics
# NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX

# Sentry (Error tracking)
# NEXT_PUBLIC_SENTRY_DSN=https://xxx@sentry.io/xxx

# PostHog (Product analytics)
# NEXT_PUBLIC_POSTHOG_KEY=phc_xxx
# NEXT_PUBLIC_POSTHOG_HOST=https://app.posthog.com

# ==============================================
# NOTES
# ==============================================

# 1. Copy this file to .env.local:
#    cp .env.local.example .env.local

# 2. Fill in your actual values (never commit .env.local!)

# 3. All pricing is in CENTS (e.g., 1900 = $19.00)

# 4. Channels are comma-separated lists

# 5. -1 for max limits means unlimited

# 6. Restart Next.js dev server after changing env vars:
#    npm run dev

# ==============================================
# SECURITY REMINDERS
# ==============================================

# ❌ NEVER commit .env.local to git
# ❌ NEVER expose SUPABASE_SERVICE_ROLE_KEY publicly
# ❌ NEVER expose STRIPE_SECRET_KEY publicly
# ✅ Only NEXT_PUBLIC_* variables are exposed to browser
# ✅ Keep service keys server-side only
# ✅ Rotate keys regularly
# ✅ Use different keys for dev/staging/production
